# USE_GEMINI: set to "true" to turn on AI mode (Gemini first, Groq as automatic fallback).
# Leave unset to use the built-in rules engine with no AI calls.
USE_GEMINI="false"

# GEMINI_API_KEY: main AI provider. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GROQ_API_KEY: fallback used when Gemini fails, is rate-limited, or has no key.
# Get one at https://console.groq.com/keys . Text only: screenshot job descriptions still need Gemini.
GROQ_API_KEY="MY_GROQ_API_KEY"
# Optional: override the Groq model (default openai/gpt-oss-120b).
# GROQ_MODEL="openai/gpt-oss-120b"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase: reuse your existing project. Copy these from Project Settings → API.
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
